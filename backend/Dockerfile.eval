# Dev-only image for eval/train_head.py and eval/evaluate.py --classifier
# embedding. Adds scikit-learn (training-only dependency, deliberately not
# in requirements.txt since runtime inference is numpy-only) on top of the
# same base as the production Dockerfile. Not used to build the production
# backend image -- see backend/Dockerfile for that.
FROM python:3.12-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-spa \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt scikit-learn

RUN mkdir -p /app/models && \
    curl -fsSL -o /app/models/vision_model_quantized.onnx \
        "https://huggingface.co/Xenova/clip-vit-base-patch32/resolve/main/onnx/vision_model_quantized.onnx" && \
    echo "583fd1110a514667812fee7d684952aaf82a99b959760c8d7dca7e0ab9839299  /app/models/vision_model_quantized.onnx" | sha256sum -c -

COPY . .

RUN mkdir -p /data/uploads /data/output /data/feedback
